+impl RustEmitter {
+    /// XML consumers can opt in to the same serde model implementations via
+    /// the "model-serde" feature. The native field and validation plan stays
+    /// identical, so XML-only builds avoid expanding irrelevant derive macros.
+    /// Generate presence-aware attribute snapshots without whole-model Serde derives.
+    pub fn generate_model_snapshots(
+        &self,
+        bundle: &Bundle,
+        bindings: &TypeBindings,
+    ) -> ContractResult<SourceMap> {
+        let plan = plan_models(bundle, bindings)?;
+        let mut output = String::from(
+            "// Generated from the validated model plan.\n\
+             #![allow(non_snake_case)]\n\
+             use super::models::*;\n\
+             use serde_json::{Map, Value};\n\
+             pub trait Snapshot { fn snapshot(&self) -> Result<Value, serde_json::Error>; }\n\
+             impl<T: Snapshot> Snapshot for Box<T> { fn snapshot(&self) -> Result<Value, serde_json::Error> { (**self).snapshot() } }\n\
+             impl<T: Snapshot> Snapshot for Vec<T> { fn snapshot(&self) -> Result<Value, serde_json::Error> { self.iter().map(Snapshot::snapshot).collect::<Result<Vec<_>,_>>().map(Value::Array) } }\n",
+        );
+        for model in &plan.models {
+            if model.attrs.iter().any(|attr| attr.union.is_some()) {
+                return Err(error(ErrorReason::UnsupportedType, &model.id, "",
+                    "snapshot generation does not support model unions"));
+            }
+            let name = &model.name;
+            let mut helpers = String::new();
+            let mut entries = Vec::new();
+            for (index, attr) in model.attrs.iter().enumerate() {
+                let value = if attr.nested_validate { "Snapshot::snapshot(value)?" }
+                    else { "serde_json::to_value(value)?" };
+                let helper = format!("__lml_snapshot_{name}_{index}");
+                entries.push(helper.clone());
+                writeln!(helpers, "#[inline(never)]\nfn {helper}(model: &{name}, data: &mut Map<String, Value>) -> Result<(), serde_json::Error> {{\n match &model.{} {{ Presence::Absent => {{}}, Presence::Null => {{ data.insert({}.into(), Value::Null); }}, Presence::Value(value) => {{ data.insert({}.into(), {value}); }} }}\n Ok(())\n}}", attr.field, quote(&attr.name), quote(&attr.name)).unwrap();
+            }
+            let entries = entries.join(", ");
+            writeln!(output, "impl Snapshot for {name} {{ fn snapshot(&self) -> Result<Value, serde_json::Error> {{ let mut data = Map::new();\n const FIELDS: &[fn(&{name}, &mut Map<String, Value>) -> Result<(), serde_json::Error>] = &[{entries}];\n for field in FIELDS {{ field(self, &mut data)?; }}").unwrap();
+            if model.ordered_content {
+                output.push_str("match &self.__lml_content { Presence::Absent => {}, Presence::Null => { data.insert(\"__lml_content\".into(), Value::Null); }, Presence::Value(value) => { data.insert(\"__lml_content\".into(), serde_json::to_value(value)?); } }\n");
+            }
+            output.push_str("Ok(Value::Object(data)) } }\n");
+            output.push_str(&helpers);
+        }
+        Ok(BTreeMap::from([("snapshots.rs".into(), output)]))
+    }
+
+    pub fn generate_xml_models(
+        &self,
+        bundle: &Bundle,
+        bindings: &TypeBindings,
+    ) -> ContractResult<SourceMap> {
+        let plan = plan_models(bundle, bindings)?;
+        for model in &plan.models {
+            for attr in &model.attrs {
+                if attr.union.is_some() || (attr.nested_validate && attr.default_wire.is_some()) {
+                    return Err(error(
+                        ErrorReason::UnsupportedType,
+                        &model.id,
+                        &attr.name,
+                        "XML-only model generation requires no serde-dependent model defaults or unions",
+                    ));
+                }
+            }
+        }
+        Ok(BTreeMap::from([(
+            "models.rs".into(),
+            emit_models(&plan, true),
+        )]))
+    }
+}
